# Environment variables for the /api/generate endpoint (validated in src/env.ts).
# Copy this file to .env and fill in real values. LLM_URL and LLM_MODEL_ID are required;
# LLM_API_KEY is optional — omit it for local servers that don't check keys.

LLM_URL=https://api.deepseek.com/v1
LLM_MODEL_ID=deepseek-flash
LLM_API_KEY=your-api-key

# Other providers (swap the values above):
# GLM:       LLM_URL=https://api.z.ai/api/coding/paas/v4  LLM_MODEL_ID=glm-5.3
# LM Studio: LLM_URL=http://localhost:1234/v1             LLM_MODEL_ID=qwen/qwen3.6-35b-a3b
#            (LLM_API_KEY can be omitted)
